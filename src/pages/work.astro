---
// Work page: every box opens into a scrollable gallery (layout transition inspired by
// Codrops' Content Layout Transition, MIT: https://github.com/codrops/ContentLayoutTransition).
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { projects, artists, type GalleryItem } from '../data/site';

type Slide = { src: string; caption: string };
const toSlide = (g: GalleryItem): Slide => (typeof g === 'string' ? { src: g, caption: '' } : { src: g.src, caption: g.caption ?? '' });
const items = projects.map((p) => {
  let slides: Slide[] =
    p.gallery === 'artists'
      ? artists.map((a) => ({ src: a.image, caption: `${a.name} — ${a.role}${a.year ? ', ' + a.year : ''}` }))
      : p.gallery.map(toSlide);
  if (!slides.length) slides = Array.from({ length: 5 }, () => ({ src: '', caption: '' }));
  const cover = p.image || slides[0].src;
  const portrait = p.gallery === 'artists';
  return { ...p, slides, cover, portrait };
});
const kinds = ['All', ...Array.from(new Set(projects.map((p) => p.kind)))];
---
<Base title="Work" description="Selected projects: campaigns, games, film, live performance and artists.">
  <section class="col head">
    <h1 class="h2">Work</h1>
    <p class="lead">Campaigns, games, film and live — click a project to see more</p>
  </section>

  <section class="col list">
    {items.map((p, i) => (
      <button class="project card" data-open={i} aria-label={`Open ${p.title}`}>
        <div class="art" data-flip-id={`art-${i}`}>
          {p.cover ? <img src={p.cover} alt="" loading="lazy" /> : <><span class="placeholder">[PROJECT KEY ART]</span><span class="kind">{p.kind.toUpperCase()}</span></>}
          {p.inProduction && <span class="pill status">In production</span>}
          <span class="count-pill">{p.slides.length} {p.slides.length === 1 ? 'image' : 'images'}</span>
        </div>
        <div class="meta">
          <div>
            <h2>{p.title}</h2>
            <p>
              <span><Icon name="note" size={14} />{p.meta}</span>
              {p.years && <span><Icon name="cal" size={14} />{p.years}</span>}
            </p>
          </div>
          <span class="go"><Icon name="arrow" size={16} /></span>
        </div>
      </button>
    ))}
  </section>

  <div class="view" data-view aria-hidden="true">
    <div class="view__bg"></div>
    {items.map((p, i) => (
      <div class:list={['g', { portrait: p.portrait }]} data-g={i} data-caps={JSON.stringify(p.slides.map((s) => s.caption))}>
        <div class="g-info">
          <p class="oh"><span class="oh__inner kicker">{p.kind}{p.years ? ` · ${p.years}` : ''}{p.inProduction ? ' · In production' : ''}</span></p>
          <h2 class="oh"><span class="oh__inner">{p.title}</span></h2>
          <p class="oh"><span class="oh__inner sub">{p.meta}</span></p>
          <p class="oh desc"><span class="oh__inner">{p.description}</span></p>
          <p class="oh cap-line"><span class="oh__inner" data-cap></span></p>
          {p.link && (
            <p class="oh"><a class="oh__inner more" href={p.link} target={/^https?:/.test(p.link) ? '_blank' : undefined} rel="noopener">{p.linkLabel || 'Learn more'} ↗</a></p>
          )}
        </div>
        <div class="g-col">
          <div class="g-track" data-track>
            {p.slides.map((s, k) => (
              <figure class="slide" data-flip-id={k === 0 ? `art-${i}` : undefined}>
                {s.src ? <img src={s.src} alt={s.caption} loading="lazy" /> : <span class="placeholder">[IMAGE {k + 1}]</span>}
              </figure>
            ))}
          </div>
        </div>
      </div>
    ))}
    <button class="back" data-back><Icon name="prev" size={16} />Back</button>
    <div class="nav">
      <button class="navbtn" data-prev aria-label="Previous image"><Icon name="prev" size={18} /></button>
      <span class="counter" data-counter></span>
      <button class="navbtn" data-next aria-label="Next image"><Icon name="next" size={18} /></button>
    </div>
  </div>
</Base>

<style>
  .head { display: flex; flex-direction: column; gap: 12px; }
  .list { display: flex; flex-direction: column; gap: 24px; padding-top: 25px; }
  .project { all: unset; box-sizing: border-box; cursor: pointer; display: flex; flex-direction: column; padding: 2px; background: var(--card); border-radius: var(--radius); transition: transform 0.25s ease; }
  .project:hover { transform: translateY(-3px); }
  .project:focus-visible { outline: 2px solid var(--link); outline-offset: 3px; }
  .art { position: relative; aspect-ratio: 640 / 430; border-radius: 10px; background: var(--card-2); overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .art img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .project:hover .art img { transform: scale(1.03); }
  .kind { font-size: 12px; letter-spacing: 0.14em; color: rgba(255, 255, 255, 0.28); }
  .status { position: absolute; right: 14px; top: 12px; backdrop-filter: blur(6px); }
  .count-pill { position: absolute; left: 14px; bottom: 12px; height: 26px; padding: 0 10px; border-radius: 13px; background: rgba(0,0,0,0.45); backdrop-filter: blur(6px); font-size: 12px; display: flex; align-items: center; opacity: 0; transform: translateY(6px); transition: all 0.3s; }
  .project:hover .count-pill { opacity: 1; transform: none; }
  .meta { padding: 10px 16px 14px; display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; }
  .meta h2 { margin: 0; font-size: 15px; line-height: 26px; font-weight: 500; }
  .meta p { margin: 4px 0 0; display: flex; flex-wrap: wrap; gap: 6px 20px; font-size: 14px; color: var(--text-50); }
  .meta p span { display: inline-flex; align-items: center; gap: 6px; }
  .go { color: var(--text-50); display: flex; transition: color 0.2s; }
  .project:hover .go { color: var(--text); }

  /* gallery view */
  .view { position: fixed; inset: 0; z-index: 50; visibility: hidden; pointer-events: none; }
  .view.open { visibility: visible; pointer-events: auto; }
  .view__bg { position: absolute; inset: 0; background: var(--bg); opacity: 0; }
  .g { position: absolute; inset: 0; display: none; }
  .g.current { display: block; }
  .g-info { position: absolute; left: 8vw; top: 50%; transform: translateY(-50%); width: min(32vw, 440px); }
  .oh { overflow: hidden; margin: 0; }
  .oh__inner { display: inline-block; will-change: transform; }
  .kicker { font-size: 14px; color: var(--text-50); }
  .g-info h2 { margin: 6px 0 6px; font-family: var(--display); font-weight: 500; font-size: clamp(34px, 3.8vw, 56px); line-height: 1.04; letter-spacing: -0.03em; }
  .sub { font-size: 16px; color: var(--text-70); }
  .desc { margin-top: 20px; }
  .desc .oh__inner { display: block; font-size: 16px; line-height: 28px; color: var(--text-60); }
  .cap-line { margin-top: 20px; min-height: 24px; }
  .cap-line .oh__inner { font-size: 15px; color: var(--text); }
  .more { margin-top: 16px; color: var(--link); font-size: 15px; }
  .g-col { position: absolute; top: 0; right: 8vw; width: min(44vw, 640px); height: 100%; }
  .g.portrait .g-col { width: min(28vw, 400px); right: 14vw; }
  .g-track { display: flex; flex-direction: column; gap: 3vh; will-change: transform; }
  .slide { position: relative; margin: 0; aspect-ratio: 640 / 430; border-radius: 10px; overflow: hidden; background: var(--card-2); opacity: 0.3; transition: opacity 0.5s; }
  .g.portrait .slide { aspect-ratio: 4 / 5; }
  .slide.current { opacity: 1; }
  .slide img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .back { position: absolute; top: 28px; left: 8vw; z-index: 3; height: 42px; padding: 0 16px; display: inline-flex; align-items: center; gap: 8px; border: 0; border-radius: 12px; background: var(--card); color: var(--text-90); font-size: 14px; cursor: pointer; opacity: 0; }
  .nav { position: absolute; right: 3vw; top: 50%; transform: translateY(-50%); z-index: 3; display: flex; flex-direction: column; align-items: center; gap: 12px; opacity: 0; }
  .navbtn { width: 44px; height: 44px; border-radius: 22px; border: 1px solid var(--line-2); background: rgba(20,20,20,0.6); color: #fff; display: flex; align-items: center; justify-content: center; cursor: pointer; transform: rotate(90deg); transition: background 0.2s; }
  .navbtn:hover { background: var(--card); }
  .navbtn:disabled { opacity: 0.2; cursor: default; }
  .counter { font-family: var(--mono); font-size: 13px; color: var(--text-50); }

  @media (max-width: 900px) {
    .g-col, .g.portrait .g-col { right: 50%; transform: translateX(50%); width: 84vw; }
    .g.portrait .g-col { width: 62vw; }
    .g-info { left: 16px; right: 16px; top: auto; bottom: calc(16px + env(safe-area-inset-bottom)); transform: none; width: auto; padding: 16px; background: var(--card); border: 1px solid var(--line-2); border-radius: 14px; max-height: 38vh; overflow-y: auto; box-shadow: 0 -20px 40px rgba(20,20,20,0.9); }
    .g-info h2 { font-size: 28px; }
    .desc { margin-top: 10px; }
    .desc .oh__inner { font-size: 14px; line-height: 22px; }
    .cap-line { margin-top: 8px; }
    .back { left: 16px; top: 16px; }
    .nav { right: 16px; top: 16px; transform: none; flex-direction: row; }
    .navbtn { transform: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { Flip } from 'gsap/Flip';
  import { onPage } from '../lib/page';
  gsap.registerPlugin(Flip);

  onPage(() => {
  const view = document.querySelector<HTMLElement>('[data-view]');
  if (view) {
    const cards = [...document.querySelectorAll<HTMLElement>('[data-open]')];
    const groups = [...view.querySelectorAll<HTMLElement>('[data-g]')];
    const bg = view.querySelector<HTMLElement>('.view__bg')!;
    const back = view.querySelector<HTMLButtonElement>('[data-back]')!;
    const nav = view.querySelector<HTMLElement>('.nav')!;
    const prev = view.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = view.querySelector<HTMLButtonElement>('[data-next]')!;
    const counter = view.querySelector<HTMLElement>('[data-counter]')!;
    const ease = 'expo.inOut';
    let g = -1, cur = 0, isOpen = false, busy = false;

    const el = () => groups[g];
    const track = () => el().querySelector<HTMLElement>('[data-track]')!;
    const slides = () => [...el().querySelectorAll<HTMLElement>('.slide')];
    const texts = () => el().querySelectorAll('.g-info .oh__inner');
    const caps = (): string[] => JSON.parse(el().dataset.caps || '[]');
    const centerY = (k: number) => { const s = slides()[k]; const f = window.innerWidth <= 900 ? 0.34 : 0.5; return window.innerHeight * f - (s.offsetTop + s.offsetHeight / 2); };
    const sync = () => {
      const n = slides().length;
      prev.disabled = cur <= 0; next.disabled = cur >= n - 1;
      counter.textContent = `${String(cur + 1).padStart(2, '0')} / ${String(n).padStart(2, '0')}`;
      slides().forEach((s, k) => s.classList.toggle('current', k === cur));
      const c = el().querySelector<HTMLElement>('[data-cap]')!;
      c.textContent = caps()[cur] || '';
    };

    const open = (i: number) => {
      if (busy || isOpen) return;
      busy = true; g = i; cur = 0;
      const art = cards[i].querySelector<HTMLElement>('.art')!;
      const state = Flip.getState(art);
      view.classList.add('open'); view.setAttribute('aria-hidden', 'false');
      el().classList.add('current');
      document.body.style.overflow = 'hidden';
      sync();
      gsap.set(track(), { y: centerY(0) });
      const [first, ...rest] = slides();
      Flip.from(state, { targets: first, duration: 1, ease, onComplete: () => { isOpen = true; busy = false; back.focus({ preventScroll: true }); } });
      gsap.fromTo(rest, { y: 120, opacity: 0 }, { y: 0, opacity: 0.3, duration: 1, ease: 'expo.out', delay: 0.35, stagger: 0.06, clearProps: 'opacity,transform' });
      gsap.to(bg, { opacity: 1, duration: 0.6, ease: 'power2.out' });
      gsap.fromTo(texts(), { yPercent: 105 }, { yPercent: 0, duration: 1, ease, stagger: 0.05 });
      gsap.to([back, nav], { opacity: 1, duration: 0.8, delay: 0.3 });
    };

    const finishClose = () => {
      const art = cards[g].querySelector<HTMLElement>('.art')!;
      const [first, ...rest] = slides();
      const state = Flip.getState(first);
      gsap.to(rest, { opacity: 0, y: 60, duration: 0.4, ease: 'power2.in' });
      gsap.to(texts(), { yPercent: -105, duration: 0.45, ease: 'power3.in' });
      gsap.to([back, nav], { opacity: 0, duration: 0.3 });
      gsap.to(bg, { opacity: 0, duration: 0.7, delay: 0.25, ease: 'power2.inOut' });
      gsap.set(first, { opacity: 0 });
      gsap.set(art, { zIndex: 60, position: 'relative' });
      Flip.from(state, {
        targets: art, duration: 0.9, ease,
        onComplete: () => {
          gsap.set(art, { clearProps: 'zIndex,position' });
          gsap.set(slides(), { clearProps: 'all' });
          el().classList.remove('current');
          view.classList.remove('open'); view.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
          cards[g].focus({ preventScroll: true });
          isOpen = false; busy = false; g = -1;
        },
      });
    };

    const close = () => {
      if (busy || !isOpen) return;
      busy = true;
      if (cur !== 0) {
        cur = 0; sync();
        gsap.to(track(), { y: centerY(0), duration: 0.5, ease: 'power3.inOut', onComplete: finishClose });
      } else finishClose();
    };

    const go = (dir: 1 | -1) => {
      const to = cur + dir;
      if (busy || !isOpen || to < 0 || to >= slides().length) return;
      busy = true; cur = to; sync();
      gsap.to(track(), { y: centerY(to), duration: 0.9, ease: 'expo.out', onComplete: () => { busy = false; } });
      const c = el().querySelector('[data-cap]');
      if (c) gsap.fromTo(c, { yPercent: dir > 0 ? 105 : -105 }, { yPercent: 0, duration: 0.6, ease: 'expo.out' });
    };

    cards.forEach((c, i) => c.addEventListener('click', () => open(i)));
    back.addEventListener('click', close);
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    view.addEventListener('click', (e) => {
      const s = (e.target as HTMLElement).closest('.slide');
      if (!s) return;
      const k = slides().indexOf(s as HTMLElement);
      if (k > cur) go(1); else if (k < cur) go(-1);
    });
    const onKey = (e: KeyboardEvent) => {
      if (!isOpen) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); go(1); }
      if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
    };
    window.addEventListener('keydown', onKey);
    let wheelLock = 0;
    view.addEventListener('wheel', (e) => {
      if ((e.target as HTMLElement).closest('.g-info')) return;
      e.preventDefault();
      const now = Date.now();
      if (now - wheelLock < 650 || Math.abs(e.deltaY) < 10) return;
      wheelLock = now; go(e.deltaY > 0 ? 1 : -1);
    }, { passive: false });
    let ty = 0;
    view.addEventListener('touchstart', (e) => { ty = e.touches[0].clientY; }, { passive: true });
    view.addEventListener('touchend', (e) => {
      if ((e.target as HTMLElement).closest('.g-info')) return;
      const d = ty - e.changedTouches[0].clientY; if (Math.abs(d) > 40) go(d > 0 ? 1 : -1);
    });
    const onResize = () => { if (isOpen) gsap.set(track(), { y: centerY(cur) }); };
    window.addEventListener('resize', onResize);
    return () => {
      window.removeEventListener('keydown', onKey);
      window.removeEventListener('resize', onResize);
      gsap.killTweensOf([view, ...view.querySelectorAll('*'), ...cards.map((c) => c.querySelector('.art'))]);
      document.body.style.overflow = '';
    };
  }
  });
</script>
